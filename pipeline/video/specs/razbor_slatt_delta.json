   "lines": [
    {
     "text": "Песчаные тела дельты — это распределительные каналы и их устьевые бары.",
     "claims": [
      {
       "unit": "u411-06",
       "page": 411,
       "quote": "Sandy reservoir facies are deposits of distributary channels and distributary mouth-bars"
      }
     ]
    },
    {
     "text": "В паводок струя из канала кладёт самый отсортированный песок у вершины бара.",
     "claims": [
      {
       "unit": "u415-05",
       "page": 415,
       "quote": "deposited the best-sorted and most-permeable sands"
      }
     ]
    },
    {
     "text": "Дальше от устья, где течение слабее, оседают мелкий песок и глина.",
     "claims": [
      {
       "unit": "u415-05",
       "page": 415,
       "quote": "Finer-grained, more poorly sorted sands and muds were deposited more distally"
      }
     ]
    }
   ]
