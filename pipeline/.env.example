# Модели задаются профилями: файлы pipeline/.env.<имя>. Цепочка — в pipeline/.env:
#   LLM_PROFILES=gemini,qwen     сначала Gemini; кончились квоты или пропала связь → Qwen
# Разово: py -3 run.py all --llm qwen --chapter ...   (или --llm mock — офлайн без модели)
# Все .env* (кроме этого примера) в git не попадают.
#
# ---- пример .env.gemini ----
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# LLM_API_KEY=<ключ из aistudio.google.com>
# LLM_PARALLEL=4
#
# ---- пример .env.qwen (llama.cpp через SSH-туннель: ssh -N -L 127.0.0.1:8081:127.0.0.1:8081 user@server) ----
# LLM_BASE_URL=http://127.0.0.1:8081/v1
# LLM_MODEL=<имя модели из /v1/models>
# LLM_PARALLEL=1          # у llama.cpp обычно один слот
# LLM_MAX_TOKENS=8192
# LLM_NO_THINK=1          # Qwen3: без режима рассуждений (иначе тысячи токенов <think> и пустой ответ)
# LLM_TIMEOUT=900
#
# Каталоги книг, если не передаются флагами --books-md / --books-pdf
BOOKS_MD=
BOOKS_PDF=
LLM_PROFILES=mock
