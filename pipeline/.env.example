# Скопируйте в pipeline/.env и заполните. Файл .env в git не попадает.
# Варианты LLM_BASE_URL:
#   mock                                                     офлайн-заглушка без модели (для тестов)
#   http://<сервер>:8000/v1                                  свой Qwen 3.6 (vLLM / Ollama / LM Studio)
#   https://generativelanguage.googleapis.com/v1beta/openai  Google Gemini (бесплатный тариф)
#   https://api.deepseek.com/v1                              DeepSeek
LLM_BASE_URL=mock
LLM_MODEL=mock
LLM_API_KEY=
LLM_TIMEOUT=300
LLM_JSON_MODE=1
# Каталоги с книгами (md и pdf), если не передаются флагами
BOOKS_MD=
BOOKS_PDF=
